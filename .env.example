# Database connection URL (optional, defaults to local SQLite)
DISCOVERY_DATABASE_URL="sqlite:///./discovery_agent.db"

# Groq LLM configuration. Copy this file to .env and add your key.
DISCOVERY_GROQ_API_KEY="your-groq-api-key-here"
# Optional: override the default model when your Groq account uses a different one.
DISCOVERY_GROQ_MODEL="openai/gpt-oss-120b"
